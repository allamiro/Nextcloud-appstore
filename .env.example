# =============================================================================
# Nextcloud App Store Deployment Toolkit — Sample Environment File
# =============================================================================
#
# THIS IS A SAMPLE CONFIGURATION FILE.
# All passwords, secret keys, and domain values below are examples only.
# You MUST change them before deploying in any real environment.
#
# Usage:
#   cp .env.example .env
#   $EDITOR .env          ← change passwords, domains, and your GitHub token
#
# The sample values below use IP address 192.168.178.165 as the host.
# Replace every occurrence of 192.168.178.165 with your actual server IP or
# hostname if you have DNS set up.
#
# Do NOT commit your .env file to version control — it contains secrets.
# =============================================================================

# =============================================================================
# STEP 1 — App Store identity (what address will it be reached on?)
# =============================================================================

# Hostname or IP of this App Store.
# Replace 192.168.178.165 with your server's IP or hostname.
APPSTORE_DOMAIN=192.168.178.165

# Hostname or IP of the file server that serves mirrored app packages.
# Can be the same machine/IP as the App Store (different port is fine).
FILESERVER_DOMAIN=192.168.178.165

# Full URL that Nextcloud uses to query the App Store API.
# MUST end with /api/v1 — this is what goes into occ config:system:set appstoreurl.
APPSTORE_API_URL=https://192.168.178.165/api/v1

# Base URL for downloading mirrored app packages.
# The file server runs on port 8443 (commercial) or 30444 (air-gapped).
FILE_SERVER_URL=https://192.168.178.165:8443/apps

# =============================================================================
# STEP 2 — Nextcloud credentials (the NC instance deployed by this stack)
# =============================================================================

# Admin account created on Nextcloud's first boot.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=NcAdmin@Sample2024!Change_Me

# Nextcloud's own PostgreSQL database password (separate from the App Store DB).
NEXTCLOUD_DB_PASSWORD=NcDb@Pg2024!Change_Me

# Additional trusted domains for Nextcloud (space-separated).
# Your server IP is already added automatically; add extra hostnames here if needed.
NEXTCLOUD_TRUSTED_DOMAINS=192.168.178.165

# Docker container name for Nextcloud (do not change unless you rename the service).
NEXTCLOUD_CONTAINER_NAME=nextcloud

# =============================================================================
# STEP 3 — App Store database
# =============================================================================

# Password for the App Store PostgreSQL user.
DB_PASSWORD=AppStoreDb@Pg2024!Change_Me

# These match the values baked into docker-compose.yml — change only if you
# are using an external PostgreSQL instance.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=nextcloudappstore
DATABASE_USER=nextcloudappstore

# =============================================================================
# STEP 4 — Django security
# =============================================================================

# Secret key for Django — must be unique per deployment and kept private.
# Generate your own:
#   tr -dc 'a-zA-Z0-9_-' < /dev/urandom | head -c 64; echo
# WARNING: Do NOT use the value below in production. Avoid $ characters.
SECRET_KEY=Rv7kXmQ2pL9nY4jA8tW1cB5hF3sD6gE0iUzNwV_oMkJrTyCfGlZeI2uPaSbHdOx

# Django allowed hosts — must include your server IP or hostname.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.178.165

# Never enable debug mode outside of local development.
DEBUG=False

# =============================================================================
# STEP 5 — Target Nextcloud version
# =============================================================================

# The exact Nextcloud version you are deploying.
# Used for compatibility checks, report generation, and the export bundle.
NEXTCLOUD_VERSION=30.0.1
NEXTCLOUD_MAJOR_VERSION=30

# =============================================================================
# STEP 6 — GitHub API token (required to sync app releases)
# =============================================================================

# Personal access token from https://github.com/settings/tokens
# Needs no special scopes — a fine-grained token with public read access works.
# Without this, the sync step will be rate-limited or fail.
GITHUB_API_TOKEN=ghp_ReplaceThisWithYourRealGitHubToken

# GitHub OAuth (only needed if you want social login on the App Store admin UI)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# STEP 7 — App Store admin user
# =============================================================================

# Django superuser created automatically on first run (leave ADMIN_PASSWORD
# blank to skip auto-creation and set the password manually later).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@192.168.178.165
ADMIN_PASSWORD=AppStoreAdmin@2024!Change_Me

# Site domain used in Django for generating links (emails, social auth).
SITE_DOMAIN=192.168.178.165

# =============================================================================
# STEP 8 — Build settings
# =============================================================================

# Which branch/tag of the upstream Nextcloud App Store to build from.
APPSTORE_VERSION=master
IMAGE_TAG=latest

# Initial data loading (set to true only on the very first run of the App Store).
LOAD_FIXTURES=false
IMPORT_TRANSLATIONS=false

# =============================================================================
# STEP 9 — Kubernetes settings (only needed for K8s deployments)
# =============================================================================

CONTAINER_RUNTIME=docker
K8S_NAMESPACE=nextcloud-appstore
KUBECTL_CONTEXT=

# =============================================================================
# STEP 10 — Nextcloud runtime (for configure-nextcloud scripts)
# =============================================================================

# compose : Nextcloud is in our Docker Compose stack (default)
# k8s     : Nextcloud is in Kubernetes
# ssh     : Nextcloud is on a bare-metal / VM host
NEXTCLOUD_RUNTIME=compose

# Kubernetes Nextcloud — fill in only when NEXTCLOUD_RUNTIME=k8s
NEXTCLOUD_K8S_NAMESPACE=nextcloud
NEXTCLOUD_K8S_POD_SELECTOR=app=nextcloud
NEXTCLOUD_K8S_CONTAINER=nextcloud

# SSH / bare-metal Nextcloud — fill in only when NEXTCLOUD_RUNTIME=ssh
NEXTCLOUD_SSH_HOST=
NEXTCLOUD_SSH_USER=
NEXTCLOUD_PATH=/var/www/html

# =============================================================================
# STEP 11 — Export bundle directories (change only if you want a different path)
# =============================================================================

AIRGAP_IMAGE_DIR=airgapped/images
AIRGAP_EXPORT_DIR=airgapped/exports

# =============================================================================
# OPTIONAL — Email (for App Store notifications and password resets)
# =============================================================================

DEFAULT_FROM_EMAIL=appstore@192.168.178.165
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# =============================================================================
# OPTIONAL — Rate limiting (defaults are safe for most deployments)
# =============================================================================

THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_APP_UPLOAD=100/day
THROTTLE_APP_REGISTER=100/day

# =============================================================================
# OPTIONAL — reCAPTCHA (leave blank to disable)
# =============================================================================

RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# =============================================================================
# OPTIONAL — Discourse integration (leave blank to disable)
# =============================================================================

DISCOURSE_URL=https://help.nextcloud.com
DISCOURSE_USER=
DISCOURSE_TOKEN=

# =============================================================================
# SSL/HTTPS
# =============================================================================

USE_HTTPS=True
