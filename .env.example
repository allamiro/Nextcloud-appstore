# =============================================================================
# Nextcloud App Store Deployment Toolkit — Environment Variables
# =============================================================================
# Copy to .env and fill in values before running any scripts.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Build Settings
# -----------------------------------------------------------------------------
APPSTORE_VERSION=master
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# App Store Domain & URLs
# -----------------------------------------------------------------------------
APPSTORE_DOMAIN=appstore.local
FILESERVER_DOMAIN=files.local

# URL that Nextcloud uses to query the local App Store API
APPSTORE_API_URL=https://appstore.local/api/v1

# Base URL where mirrored app archives are served
FILE_SERVER_URL=https://files.local/apps

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
CONTAINER_RUNTIME=docker

# Kubernetes namespace for App Store deployment
K8S_NAMESPACE=nextcloud-appstore

# Optional: kubectl context to use (leave blank for current context)
KUBECTL_CONTEXT=

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_PASSWORD=changeme_staging_password
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=nextcloudappstore
DATABASE_USER=nextcloudappstore

# -----------------------------------------------------------------------------
# Django Security Settings
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a unique secret key for production!
# Use: env LC_CTYPE=C tr -dc "a-zA-Z0-9_-" < /dev/urandom | head -c 64; echo
# NOTE: Avoid $ characters — docker-compose interprets them as variables
SECRET_KEY=K9xmR2vL7pNqW4jF8tY1cB5hA3sD6gE0iUzXwV_oMkJnHbQrTyPaCfGlZeI2uOx3

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,appstore.local

# Set to True only for local debugging (never in production)
DEBUG=False

# -----------------------------------------------------------------------------
# Initial Setup Flags (set to true on first run only)
# -----------------------------------------------------------------------------
LOAD_FIXTURES=false
IMPORT_TRANSLATIONS=false

# -----------------------------------------------------------------------------
# Admin User (optional — created automatically on first run if set)
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Site Domain (for social login and email links)
# -----------------------------------------------------------------------------
SITE_DOMAIN=appstore.local

# -----------------------------------------------------------------------------
# GitHub OAuth (for social login — not used in air-gapped environments)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# -----------------------------------------------------------------------------
# GitHub API Token (required for syncing Nextcloud releases from GitHub)
# -----------------------------------------------------------------------------
GITHUB_API_TOKEN=ghp_your_github_personal_access_token

# -----------------------------------------------------------------------------
# Nextcloud Instance (deployed as part of this stack on both sides)
# -----------------------------------------------------------------------------
# Admin credentials for the Nextcloud that is deployed alongside the App Store.
# These are used on both the commercial side (docker-compose.yml) and the
# air-gapped side (airgapped/docker-compose/docker-compose.airgapped.yml).
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme_nc_admin

# Nextcloud database password (separate from the App Store DB)
NEXTCLOUD_DB_PASSWORD=changeme_nc_db_password

# Trusted domains for Nextcloud (space-separated; localhost and nextcloud are always added)
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud.local

# Container name for the Nextcloud container (used by configure scripts)
NEXTCLOUD_CONTAINER_NAME=nextcloud

# -----------------------------------------------------------------------------
# Target Nextcloud Version (for compatibility checking and export bundles)
# -----------------------------------------------------------------------------
# The exact NC version deployed — used by check-compat, report, and export.
NEXTCLOUD_VERSION=30.0.1
NEXTCLOUD_MAJOR_VERSION=30

# -----------------------------------------------------------------------------
# Nextcloud Runtime (for configure-nextcloud scripts on non-compose deployments)
# -----------------------------------------------------------------------------
# compose : Nextcloud is in a Docker Compose stack (default — our own stack)
# k8s     : Nextcloud is in Kubernetes (configure-nextcloud-k8s.sh)
# ssh     : Nextcloud is on a bare-metal host (configure-nextcloud-ssh.sh)
NEXTCLOUD_RUNTIME=compose

# Kubernetes Nextcloud (only needed when NEXTCLOUD_RUNTIME=k8s)
NEXTCLOUD_K8S_NAMESPACE=nextcloud
NEXTCLOUD_K8S_POD_SELECTOR=app=nextcloud
NEXTCLOUD_K8S_CONTAINER=nextcloud

# SSH / Bare-Metal Nextcloud (only needed when NEXTCLOUD_RUNTIME=ssh)
NEXTCLOUD_SSH_HOST=
NEXTCLOUD_SSH_USER=
NEXTCLOUD_PATH=/var/www/html

# -----------------------------------------------------------------------------
# Packaging (air-gapped export bundle)
# -----------------------------------------------------------------------------
# Directories for saved Docker images and exported DB/archives
AIRGAP_IMAGE_DIR=airgapped/images
AIRGAP_EXPORT_DIR=airgapped/exports
# Note: nextcloud:stable-apache is always included in the bundle since
# Nextcloud must be deployed from images in the air-gapped environment.

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
DEFAULT_FROM_EMAIL=appstore@example.com
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# -----------------------------------------------------------------------------
# reCAPTCHA (optional)
# -----------------------------------------------------------------------------
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Discourse Integration (optional)
# -----------------------------------------------------------------------------
DISCOURSE_URL=https://help.nextcloud.com
DISCOURSE_USER=
DISCOURSE_TOKEN=

# -----------------------------------------------------------------------------
# SSL/HTTPS
# -----------------------------------------------------------------------------
USE_HTTPS=True

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_APP_UPLOAD=100/day
THROTTLE_APP_REGISTER=100/day
